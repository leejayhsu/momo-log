package web

import (
	"strconv"
	"time"

	templpkg "github.com/a-h/templ"

	"momo-poo/components"
	"momo-poo/components/alertdialog"
	"momo-poo/components/button"
	"momo-poo/components/card"
	"momo-poo/components/toast"
)

templ layout(title string, activePath string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#f6efe1"/>
			<meta name="application-name" content="Momo Poo"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<meta name="apple-mobile-web-app-title" content="Momo Poo"/>
			<title>{ title }</title>
			<link rel="manifest" href="/static/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/static/apple-touch-icon.png"/>
			<link rel="stylesheet" href="/static/shadcn.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			@components.Scripts()
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to content</a>
			<div class="site-shell">
				<header class="site-header">
					<a class="brand" href="/" aria-label="Momo bathroom tracker home">
						@pawIcon()
						<span><strong>Momo</strong><small>outdoor log</small></span>
					</a>
					<nav class="primary-nav" aria-label="Primary navigation">
						<a href="/" class={ navClass(activePath == "/") } aria-current={ currentPage(activePath == "/") }>Logs</a>
						<a href="/settings" class={ navClass(activePath == "/settings") + " nav-icon" } aria-current={ currentPage(activePath == "/settings") } aria-label="Settings" title="Settings">@settingsIcon()</a>
					</nav>
				</header>
				<main id="main-content">
					{ children... }
				</main>
				<footer class="site-footer"><span aria-hidden="true">MOMO / FIELD NOTES</span><span>Every outing counts.</span></footer>
			</div>
			@toast.Toaster()
		</body>
	</html>
}

templ HomePage(data HomePageData) {
	@layout("Log a trip | Momo", "/") {
		<section class="hero" aria-labelledby="log-heading">
			<div class="eyebrow">Bathroom check-in</div>
			<h1 id="log-heading">How did the walk go?</h1>
			<p>One tap saves the current time. Momo always pees, so just tell us about the poo.</p>
		</section>
		if data.SuccessMessage != "" {
			@toast.Toast(toast.Props{
				Title:       "Trip logged",
				Description: data.SuccessMessage,
				Type:        toast.TypeSuccess,
			})
		}
		<section class="trip-actions" aria-label="Log Momo's bathroom trip">
			<form method="post" action="/trips">
				<input type="hidden" name="has_poo" value="true"/>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "trip-button trip-button-poo"}) {
					<span class="trip-icon" aria-hidden="true">@pooIcon()</span>
					<span class="trip-label">Poo</span>
					<span class="trip-hint">Pee + poo</span>
				}
			</form>
			<form method="post" action="/trips">
				<input type="hidden" name="has_poo" value="false"/>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "trip-button trip-button-pee"}) {
					<span class="trip-icon" aria-hidden="true">@dropIcon()</span>
					<span class="trip-label">No poo</span>
					<span class="trip-hint">Pee only</span>
				}
			</form>
		</section>
		<section class="home-grid" aria-label="Today's activity">
			@card.Card() {
				@card.Header() {
					@card.Title() { Today }
					@card.Description() { { homeDate(data.Now) } }
				}
				@card.Content() {
					<div class="summary-content">
						<div class="summary-total"><strong>{ strconv.Itoa(data.TodayTrips) }</strong><span>trips outside</span></div>
						<div class="summary-breakdown">
							<div><span class="dot dot-poo"></span><strong>{ strconv.Itoa(data.TodayPoos) }</strong><span>with poo</span></div>
							<div><span class="dot dot-pee"></span><strong>{ strconv.Itoa(data.TodayNoPoos()) }</strong><span>pee only</span></div>
						</div>
					</div>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() { Recent trips }
					@card.Description() { Today and yesterday }
				}
				@card.Content() {
					<div class="recent-content">@tripList(data.RecentTrips, 0)</div>
				}
			}
		</section>
	}
}

templ SettingsPage() {
	@layout("Settings | Momo", "/settings") {
		<section class="settings-page" aria-labelledby="settings-heading">
			<div class="eyebrow">Preferences</div>
			<h1 id="settings-heading">Settings</h1>
			<p>Manage how Momo keeps you updated.</p>
			<div class="settings-card">
				@card.Card() {
					@card.Header() {
						@card.Title() { Notifications }
						@card.Description() { Trip alerts on this device }
					}
					@card.Content() {
						<div class="settings-content">
							<section class="notification-panel" data-push-panel hidden aria-labelledby="notification-heading">
								<div>
									<strong id="notification-heading">Trip notifications</strong>
									<span data-push-status>Get an alert whenever someone logs a trip.</span>
								</div>
								@button.Button(button.Props{Attributes: templpkg.Attributes{"data-push-toggle": true}}) { Enable notifications }
							</section>
						</div>
					}
				}
			</div>
		</section>
	}
}

templ ErrorPage(data ErrorPageData) {
	@layout(data.Title+" | Momo", "") {
		<section class="error-page">
			<div class="error-code">{ strconv.Itoa(data.StatusCode) }</div>
			<div class="eyebrow">Wrong turn</div>
			<h1>{ data.Title }</h1>
			<p>{ data.Message }</p>
			@button.Button(button.Props{Href: "/", Class: "back-button"}) { Back to trip logger }
		</section>
	}
}

templ tripList(trips []Trip, limit int) {
	if len(trips) == 0 {
		@emptyState("No trips yet", "Momo's next outing will appear here.")
	} else {
		<ul class="trip-list">
			for index, trip := range trips {
				if limit == 0 || index < limit {
					<li>
						<span class={ tripBadgeClass(trip.HasPoo) } aria-hidden="true">@tripTypeIcon(trip.HasPoo)</span>
						<div><strong>{ tripTypeLabel(trip.HasPoo) }</strong><time datetime={ trip.OccurredAt.Format(time.RFC3339) }>{ trip.OccurredAt.Format("Mon, Jan 2 at 3:04 PM") }</time></div>
						@deleteTripDialog(trip)
					</li>
				}
			}
		</ul>
	}
}

templ deleteTripDialog(trip Trip) {
	@alertdialog.AlertDialog() {
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size: button.SizeIconLg,
			Class: "delete-trip-trigger",
			Attributes: mergeAttributes(alertdialog.Trigger(ctx), templpkg.Attributes{
				"aria-label": "Delete trip from " + trip.OccurredAt.Format("Monday at 3:04 PM"),
				"title": "Delete trip",
			}),
		}) {
			@trashIcon()
		}
		@alertdialog.Content(alertdialog.ContentProps{Size: alertdialog.SizeSm}) {
			@alertdialog.Header() {
				@alertdialog.Title() { Delete this trip? }
				@alertdialog.Description() {
					This will permanently delete the { tripTypeLabel(trip.HasPoo) } trip logged { trip.OccurredAt.Format("Monday, Jan 2 at 3:04 PM") }.
				}
			}
			<p class="delete-trip-error" data-delete-trip-error role="alert" hidden>Could not delete this trip. Please try again.</p>
			@alertdialog.Footer() {
				@alertdialog.Cancel() { Cancel }
				@alertdialog.Action(alertdialog.ActionProps{
					Variant: button.VariantDestructive,
					Attributes: templpkg.Attributes{"data-delete-trip": strconv.FormatInt(trip.ID, 10)},
				}) { Delete }
			}
		}
	}
}

templ emptyState(title string, message string) {
	<div class="empty-state"><span aria-hidden="true">@pawIcon()</span><strong>{ title }</strong><p>{ message }</p></div>
}

templ tripTypeIcon(hasPoo bool) {
	if hasPoo {
		@pooIcon()
	} else {
		@dropIcon()
	}
}

templ pawIcon() {
	<svg viewBox="0 0 48 48" role="img" aria-hidden="true"><ellipse cx="24" cy="31" rx="11" ry="9"></ellipse><ellipse cx="10" cy="22" rx="5" ry="6" transform="rotate(-25 10 22)"></ellipse><ellipse cx="19" cy="13" rx="5" ry="6"></ellipse><ellipse cx="29" cy="13" rx="5" ry="6"></ellipse><ellipse cx="38" cy="22" rx="5" ry="6" transform="rotate(25 38 22)"></ellipse></svg>
}

templ pooIcon() {
	<svg viewBox="0 0 64 64" role="img" aria-hidden="true"><path d="M19 49h30c7 0 11-4 11-10 0-5-4-9-10-10 1-7-4-12-11-12 0-7-4-11-10-14 1 8-4 13-9 17-4 3-5 6-4 10-7 1-11 5-11 10 0 6 5 9 14 9Z"></path><circle cx="25" cy="34" r="2.5"></circle><circle cx="43" cy="34" r="2.5"></circle><path class="icon-detail" d="M28 42c3 2 7 2 10 0"></path></svg>
}

templ dropIcon() {
	<svg viewBox="0 0 64 64" role="img" aria-hidden="true"><path d="M32 4C26 16 14 28 14 40a18 18 0 0 0 36 0C50 28 38 16 32 4Z"></path><path class="icon-detail" d="M23 42c1 6 5 9 11 10"></path></svg>
}

templ settingsIcon() {
	<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
}

templ trashIcon() {
	<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v5"></path><path d="M14 11v5"></path></svg>
}

func navClass(active bool) string {
	if active { return "nav-link active" }
	return "nav-link"
}

func currentPage(active bool) string {
	if active { return "page" }
	return "false"
}

func homeDate(now time.Time) string {
	if now.IsZero() { now = time.Now() }
	return now.Format("Monday, January 2")
}

func tripTypeLabel(hasPoo bool) string {
	if hasPoo { return "Pee + poo" }
	return "Pee only"
}

func tripBadgeClass(hasPoo bool) string {
	if hasPoo { return "trip-badge trip-badge-poo" }
	return "trip-badge trip-badge-pee"
}

func mergeAttributes(first, second templpkg.Attributes) templpkg.Attributes {
	result := make(templpkg.Attributes, len(first)+len(second))
	for key, value := range first { result[key] = value }
	for key, value := range second { result[key] = value }
	return result
}
